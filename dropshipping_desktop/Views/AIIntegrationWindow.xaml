<Window x:Class="DropshippingApp.Views.AIIntegrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Integration Hub" Height="900" Width="1400"
        Background="#F5F5F5" WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl>
            <!-- Tab 1: AI Chat (Gemini, Copilot, Perplexity) -->
            <TabItem Header="🤖 AI Chat Hub" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="20">
                        <ComboBox x:Name="AISelector" Height="35" Margin="0,0,0,10">
                            <ComboBoxItem>Google Gemini</ComboBoxItem>
                            <ComboBoxItem>Microsoft Copilot</ComboBoxItem>
                            <ComboBoxItem>Perplexity AI</ComboBoxItem>
                            <ComboBoxItem>Amazon Q</ComboBoxItem>
                        </ComboBox>

                        <TextBlock Text="Chat:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBox x:Name="ChatOutput" Height="500" Margin="0,0,0,10" 
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 Background="White" Padding="10" TextWrapping="Wrap"/>

                        <TextBlock Text="Eingabe:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="ChatInput" Height="40" Padding="10" 
                                     Margin="0,0,10,0" Width="400"/>
                            <Button Content="📤 Senden" Height="40" Width="100" 
                                    Background="#007ACC" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,20,20,20">
                        <TextBlock Text="AI Modelle:" FontWeight="Bold" Margin="0,0,0,10"/>
                        <CheckBox Content="Gemini Pro" Margin="0,5,0,0"/>
                        <CheckBox Content="GPT-4" Margin="0,5,0,0"/>
                        <CheckBox Content="Claude 3" Margin="0,5,0,0"/>
                        <CheckBox Content="Perplexity" Margin="0,5,0,0"/>
                        <CheckBox Content="Amazon Q" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: Drawing Canvas -->
            <TabItem Header="🎨 Drawing Canvas" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="🖌️ Brush" Width="80" Height="40" Margin="5,0,0,0"/>
                        <Button Content="✏️ Pencil" Width="80" Height="40" Margin="5,0,0,0"/>
                        <Button Content="🗑️ Clear" Width="80" Height="40" Margin="5,0,0,0"/>
                        <Button Content="💾 Save" Width="80" Height="40" Margin="5,0,0,0"/>
                        <Button Content="🤖 AI Generate" Width="120" Height="40" Margin="5,0,0,0" Background="#28A745" Foreground="White"/>
                        <Slider Width="150" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Brush Size" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <Canvas Grid.Row="1" Background="White" x:Name="DrawingCanvas" Margin="10"/>
                </Grid>
            </TabItem>

            <!-- Tab 3: Website to VSG Converter -->
            <TabItem Header="🌐 Website Converter" Padding="10">
                <Grid>
                    <StackPanel Margin="20">
                        <TextBlock Text="Website URL:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBox x:Name="WebsiteUrl" Height="35" Padding="10" Width="400"/>
                            <Button Content="📥 Import" Height="35" Width="100" Margin="10,0,0,0" Background="#007ACC" Foreground="White"/>
                        </StackPanel>

                        <TextBlock Text="Konvertierungsoptionen:" FontWeight="Bold" Margin="0,10,0,10"/>
                        <CheckBox Content="HTML zu XAML" Margin="0,5,0,0"/>
                        <CheckBox Content="CSS zu WPF Styles" Margin="0,5,0,0"/>
                        <CheckBox Content="JavaScript zu C#" Margin="0,5,0,0"/>
                        <CheckBox Content="Responsive Design" Margin="0,5,0,0"/>

                        <TextBlock Text="Vorschau:" FontWeight="Bold" Margin="0,20,0,10"/>
                        <Border BorderBrush="#DDD" BorderThickness="1" Height="400" Margin="0,0,0,10">
                            <TextBox x:Name="ConversionPreview" IsReadOnly="True" TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" Padding="10"/>
                        </Border>

                        <Button Content="✅ Konvertieren & Einfügen" Height="40" Background="#28A745" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 4: Autonomous Agent -->
            <TabItem Header="🤖 Autonomous Agent" Padding="10">
                <Grid>
                    <StackPanel Margin="20">
                        <TextBlock Text="Amazon Q - Autonomous Dropshipping Agent" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Agent Status:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="🟢 ACTIVE - 1000 Clones Running" Foreground="Green" FontSize="12" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Aktive Clones" FontWeight="Bold"/>
                                    <TextBlock Text="1000" FontSize="24" Foreground="#007ACC"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="15" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Verdienst/Stunde" FontWeight="Bold"/>
                                    <TextBlock Text="$5,000" FontSize="24" Foreground="#28A745"/>
                                </StackPanel>
                            </Border>

                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Bestellungen/Tag" FontWeight="Bold"/>
                                    <TextBlock Text="2,500+" FontSize="24" Foreground="#FFC107"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Agent Tasks:" FontWeight="Bold" Margin="0,10,0,10"/>
                        <CheckBox Content="Automatische Produktsuche" Margin="0,5,0,0" IsChecked="True"/>
                        <CheckBox Content="Preisoptimierung" Margin="0,5,0,0" IsChecked="True"/>
                        <CheckBox Content="Bestellverwaltung" Margin="0,5,0,0" IsChecked="True"/>
                        <CheckBox Content="Lieferantenkommunikation" Margin="0,5,0,0" IsChecked="True"/>
                        <CheckBox Content="Kundenservice" Margin="0,5,0,0" IsChecked="True"/>

                        <TextBlock Text="Logs:" FontWeight="Bold" Margin="0,20,0,10"/>
                        <TextBox Height="200" IsReadOnly="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" Padding="10" Background="White">
                            [10:30] Clone #1-100: Searching products...
[10:31] Clone #101-200: Processing orders...
[10:32] Clone #201-300: Optimizing prices...
[10:33] Clone #301-400: Contacting suppliers...
[10:34] Clone #401-500: Managing inventory...
[10:35] Clone #501-1000: Generating revenue...
                        </TextBox>

                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                            <Button Content="▶️ Start Agent" Height="40" Width="120" Background="#28A745" Foreground="White"/>
                            <Button Content="⏸️ Pause" Height="40" Width="120" Margin="10,0,0,0"/>
                            <Button Content="🛑 Stop" Height="40" Width="120" Margin="10,0,0,0" Background="#DC3545" Foreground="White"/>
                            <Button Content="📊 Analytics" Height="40" Width="120" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 5: Graphic AI -->
            <TabItem Header="🎨 Graphic AI" Padding="10">
                <Grid>
                    <StackPanel Margin="20">
                        <TextBlock Text="AI Image Generation" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Prompt:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox Height="60" Padding="10" TextWrapping="Wrap" Margin="0,0,0,10"
                                 Text="A professional product photo for Amazon listing..."/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="🎨 Generate with DALL-E" Height="40" Width="150" Background="#007ACC" Foreground="White"/>
                            <Button Content="🎨 Generate with Midjourney" Height="40" Width="170" Margin="10,0,0,0" Background="#007ACC" Foreground="White"/>
                            <Button Content="🎨 Generate with Stable Diffusion" Height="40" Width="200" Margin="10,0,0,0" Background="#007ACC" Foreground="White"/>
                        </StackPanel>

                        <TextBlock Text="Generated Images:" FontWeight="Bold" Margin="0,10,0,10"/>
                        <Grid Height="400">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="#DDD" BorderThickness="1" Margin="5" Background="#E8E8E8">
                                <TextBlock Text="Image 1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border BorderBrush="#DDD" BorderThickness="1" Margin="5" Background="#E8E8E8" Grid.Column="1">
                                <TextBlock Text="Image 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border BorderBrush="#DDD" BorderThickness="1" Margin="5" Background="#E8E8E8" Grid.Column="2">
                                <TextBlock Text="Image 3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <Button Content="✅ Use Selected Image" Height="40" Margin="0,15,0,0" Background="#28A745" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
