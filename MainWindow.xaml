<Window x:Class="Kontrollzentrum.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontrollzentrum - Desktop App" Height="600" Width="900"
        Background="#1e1e1e" Foreground="#ffffff">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <StackPanel Grid.Column="0" Background="#252526">
            <TextBlock Text="KONTROLLZENTRUM" FontSize="14" FontWeight="Bold" Margin="10,10,10,20" Foreground="#00d4ff"/>

            <Button Content="🏠 Dashboard" Click="ShowDashboard" Style="{StaticResource SidebarButton}" Margin="10,5"/>
            <Button Content="📊 Module" Click="ShowModules" Style="{StaticResource SidebarButton}" Margin="10,5"/>
            <Button Content="🔑 API-Keys" Click="ShowKeys" Style="{StaticResource SidebarButton}" Margin="10,5"/>
            <Button Content="🧪 Tests" Click="ShowTests" Style="{StaticResource SidebarButton}" Margin="10,5"/>
            <Button Content="⚙️ Einstellungen" Click="ShowSettings" Style="{StaticResource SidebarButton}" Margin="10,5"/>
            <Button Content="❌ Beenden" Click="Exit" Style="{StaticResource SidebarButton}" Margin="10,5"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="#1e1e1e" Padding="20">
            <StackPanel Name="ContentPanel">
                <TextBlock Name="TitleText" Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="#00d4ff" Margin="0,0,0,20"/>
                <TextBlock Name="ContentText" Text="Willkommen im Kontrollzentrum!" FontSize="14" Foreground="#ffffff" TextWrapping="Wrap"/>
                <ListBox Name="ModuleList" Background="#252526" Foreground="#ffffff" Margin="0,20,0,0" Height="300"/>
                <Button Content="🚀 Alle Module starten" Click="RunAllModules" Background="#00d4ff" Foreground="#000000" Padding="10" Margin="0,20,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="#3e3e42"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
</Window>
